{
  "name": "vordr",
  "version": "0.1.0",
  "description": "A modern, secure and open-source remote camera server.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/teemulin/Vordr.git"
  },
  "bugs": {
    "url": "https://github.com/teemulin/Vordr/issues"
  },
  "homepage": "https://github.com/teemulin/Vordr",
  "keywords": [
    "camera",
    "webrtc",
    "fastify",
    "typescript",
    "privacy",
    "self-hosted",
    "security",
    "remote-camera"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm run build:server && pnpm --filter @vordr/web build",
    "build:server": "tsc",
    "start": "node dist/index.js",
    "typecheck": "pnpm run typecheck:server && pnpm --filter @vordr/web typecheck",
    "typecheck:server": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/backend",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.10.0"
  }
}
